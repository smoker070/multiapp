#!/usr/bin/env bash
# multiapp — prototype multi-profile launcher (macOS + Linux; Windows: multiapp.ps1)
# Project: Multiapp · Phase 0 prototype
# Mechanism (verified on macOS, experiments E1/E2/E4/E11; same lever on all OSes
# because it is Electron/Chromium, not app-specific):
#   launch <App> with  --user-data-dir=<profile dir>     ← EQUALS form is mandatory
# No binaries are modified. No env overrides needed. Keychain is never touched.
set -euo pipefail

VERSION="0.2.0"

# ================================================================ platform layer
case "$(uname -s)" in
  Darwin) PLATFORM=darwin ;;
  Linux)  PLATFORM=linux ;;
  *) printf 'multiapp: unsupported platform %s (on Windows use multiapp.ps1)\n' "$(uname -s)" >&2; exit 1 ;;
esac

if [ "$PLATFORM" = darwin ]; then
  ROOT_DEFAULT="$HOME/Library/Application Support/Multiapp"
  WRAPPERS="$HOME/Applications/Multiapp"
  CLAUDE_MAIN="$HOME/Library/Application Support/Claude"
  SCAN_DIRS=(/Applications "$HOME/Applications")
else
  ROOT_DEFAULT="${XDG_DATA_HOME:-$HOME/.local/share}/multiapp"
  WRAPPERS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"   # .desktop launchers
  CLAUDE_MAIN="${XDG_CONFIG_HOME:-$HOME/.config}/Claude"
  SCAN_DIRS=(/usr/share/applications "$HOME/.local/share/applications")
fi
ROOT="${MULTIAPP_HOME:-$ROOT_DEFAULT}"
PROFILES="$ROOT/Profiles"
TRASH="$ROOT/Trash"
USER_REG="$ROOT/registry.local"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/multiapp/target"

# self-register this script's real location so the launcher stub self-heals after a move
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
if [ "$(cat "$CONF" 2>/dev/null || true)" != "$SELF" ]; then
  mkdir -p "$(dirname "$CONF")" 2>/dev/null || true
  printf '%s' "$SELF" > "$CONF" 2>/dev/null || true
fi

# --- platform-specific primitives -------------------------------------------
stat_mtime() { # $1=path → epoch seconds
  if [ "$PLATFORM" = darwin ]; then stat -f %m "$1"; else stat -c %Y "$1"; fi
}

cp_clone() { # $1=src $2=dst  (fast copy-on-write when the FS supports it)
  if [ "$PLATFORM" = darwin ]; then cp -c -R "$1" "$2" 2>/dev/null || cp -R "$1" "$2"
  else cp -R --reflink=auto "$1" "$2" 2>/dev/null || cp -R "$1" "$2"; fi
}

os_version() {
  if [ "$PLATFORM" = darwin ]; then printf 'macOS %s' "$(sw_vers -productVersion 2>/dev/null || echo '?')"
  else printf '%s' "$( ( . /etc/os-release 2>/dev/null && echo "$PRETTY_NAME" ) || uname -sr )"; fi
}

app_exec() { # $1=registry app path → the actual executable to launch
  if [ "$PLATFORM" = darwin ]; then
    local exe; exe="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$1/Contents/Info.plist" 2>/dev/null)" \
      || die "cannot read Info.plist of $1"
    printf '%s/Contents/MacOS/%s' "$1" "$exe"
  else
    printf '%s' "$1"   # on Linux the registry path IS the binary/AppImage
  fi
}

app_installed() { # $1=registry app path → 0 if present
  if [ "$PLATFORM" = darwin ]; then [ -d "$1" ]; else [ -x "$1" ] || command -v "$1" >/dev/null 2>&1; fi
}

plat_launch() { # $1=app path  $2=data dir  then extra flags + passthrough args
  local app="$1" data="$2"; shift 2
  if [ "$PLATFORM" = darwin ]; then
    # open -n forces a new instance; --args passes flags to the app
    open -n "$app" --args --user-data-dir="$data" "$@"
  else
    # Linux: separate --user-data-dir → separate singleton lock → new instance
    local bin; bin="$(app_exec "$app")"
    setsid "$bin" --user-data-dir="$data" "$@" >/dev/null 2>&1 < /dev/null &
  fi
}

# =============================================================== registry
# key|app path|display name|adapter|verdict|note
# adapter: electron = --user-data-dir only · vscode = + --extensions-dir
# NB paths below are macOS. On Linux run `multiapp scan` to populate registry.local
# with the real binary paths for your distro (app locations vary too much to hardcode).
REGISTRY="\
claude|/Applications/Claude.app|Claude|electron|supported|
chatgpt|/Applications/ChatGPT.app|ChatGPT|electron|partial|Data isolates but the ACCOUNT is shared across profiles (Keychain identity). Do NOT sign out inside a profile.
notion|/Applications/Notion.app|Notion|electron|supported|
notion-calendar|/Applications/Notion Calendar.app|Notion Calendar|electron|supported|
github|/Applications/GitHub Desktop.app|GitHub Desktop|electron|supported|
vscode|/Applications/Visual Studio Code.app|Visual Studio Code|vscode|supported|
antigravity|/Applications/Antigravity.app|Antigravity|vscode|supported|
antigravity-ide|/Applications/Antigravity IDE.app|Antigravity IDE|vscode|supported|
openmtp|/Applications/OpenMTP.app|OpenMTP|electron|supported|
gemini|/Applications/Gemini.app|Gemini|none|unsupported|Native app, no isolation lever exists (E6).
chatgpt-classic|/Applications/ChatGPT Classic.app|ChatGPT Classic|none|unsupported|Native pre-merge app, no levers; shares OpenAI identity with new ChatGPT.
telegram|/Applications/Telegram.app|Telegram|none|unsupported|Sandboxed (container is bundle-ID-keyed). Use Telegram's built-in multi-account instead.
telegram-desktop|/Applications/Telegram Desktop.app|Telegram Desktop|none|unsupported|Separate app from Telegram for macOS, with its own login. Not Electron, so no profiles — but its data/session back up fine.
hdrezka|/Applications/HDRezka-Client.app|HDRezka-Client|none|unsupported|App overrides userData in its own code (E11); flag is ignored."

full_registry() {
  printf '%s\n' "$REGISTRY"
  [ -f "$USER_REG" ] && grep -v '^[[:space:]]*$' "$USER_REG" || true
}

reg_field() { # $1=key $2=field-index(1..6)
  full_registry | awk -F'|' -v k="$1" -v f="$2" '$1==k {print $f; exit}'
}

die()  { printf 'multiapp: %s\n' "$*" >&2; exit 1; }
warn() { printf '!!  %s\n' "$*" >&2; }
info() { printf '%s\n' "$*"; }

validate_name() {
  local re='^[a-zA-Z0-9][a-zA-Z0-9 _-]{0,40}$'
  [[ "$1" =~ $re ]] || \
    die "invalid profile name '$1' (letters, digits, spaces, _ and -; must start alphanumeric)"
  [[ "$1" == *" " ]] && die "invalid profile name '$1' (must not end with a space)"
  return 0
}

require_app() { # $1=key → echoes app path
  local key="$1" path verdict note
  path="$(reg_field "$key" 2)"
  [ -n "$path" ] || die "unknown app '$key' — see: multiapp apps"
  verdict="$(reg_field "$key" 5)"
  note="$(reg_field "$key" 6)"
  if [ "$verdict" = "unsupported" ]; then die "'$key' is UNSUPPORTED: $note"; fi
  if [ "$verdict" = "untested" ]; then warn "'$key' is untested — verify it first with: multiapp probe $key"; fi
  app_installed "$path" || die "app not installed: $path"
  printf '%s' "$path"
}

profile_dir() { printf '%s/%s/%s' "$PROFILES" "$1" "$2"; }

running_pids() { # $1=profile dir → pids of ANY process bound to this profile
  ps -eo pid,args 2>/dev/null | grep -F -- "--user-data-dir=$1" | grep -v grep | awk '{print $1}'
}

main_pid() { # $1=app path $2=profile dir → pid of the main process only
  local exe; exe="$(app_exec "$1")"
  ps -eo pid,args 2>/dev/null | grep -F -- "$exe --user-data-dir=$2" | grep -v grep | awk '{print $1}' | head -1
}

is_running() { [ -n "$(running_pids "$1")" ]; }

assert_inside_root() { # safety: refuse to operate outside our root
  case "$(cd "$(dirname "$1")" 2>/dev/null && pwd)/$(basename "$1")" in
    "$ROOT"/*) ;;
    *) die "safety stop: '$1' is outside $ROOT" ;;
  esac
}

# ================================================================ backup / migrate
# Same-machine backup & restore of an app's REAL local data (not a profile).
# Verdicts (see BACKUP-MIGRATE-SPEC): same-machine restore is FULL incl. login because the
# Keychain is still present; cross-machine migration would move content but not the Keychain-bound
# login. This build ships the same-machine half only.
#
# backup_spec <key> prints tab-rows:  V <verdict>  |  A <authLocus>  |  D <abs data path>  |  X <exclude glob>
# (X excludes are cache dirs, relative to the parent of each D root; skipped unless --include-cache)
AS_DIR="$HOME/Library/Application Support"

# Standard per-bundle-ID locations that apps use for the WEB SESSION and settings. Missing these was
# why a restore brought back history but not the login: cookies/localStorage for native web-view apps
# live in HTTPStorages/WebKit, never in Application Support.
bundle_id_of() { /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$(reg_field "$1" 2)/Contents/Info.plist" 2>/dev/null; }
standard_paths() { # $1 = registry key → emits "D <path>" lines for whatever exists
  local bid; bid="$(bundle_id_of "$1")"; [ -n "$bid" ] || return 0
  local p
  for p in "$HOME/Library/HTTPStorages/$bid" \
           "$HOME/Library/HTTPStorages/$bid.binarycookies" \
           "$HOME/Library/WebKit/$bid" \
           "$HOME/Library/Preferences/$bid.plist"; do
    [ -e "$p" ] && printf 'D %s\n' "$p"
  done
  return 0
}

backup_spec() {
  local elec_excludes=$'X Cache\nX Code Cache\nX GPUCache\nX DawnGraphiteCache\nX DawnWebGPUCache\nX Crashpad\nX component_crx_cache'
  case "$1" in
    claude)
      printf 'V full-samemac\nA keychain\nD %s\n%s\nX */vm_bundles\n' "$AS_DIR/Claude" "$elec_excludes" ;;
    chatgpt)          # the NEW ChatGPT (com.openai.codex) = Chromium data in Codex/
      printf 'V full-samemac\nA keychain\nD %s\nD %s\n%s\n' "$AS_DIR/Codex" "$AS_DIR/com.openai.codex" "$elec_excludes" ;;
    # chatgpt-classic: removed from the backup list on request — repeated GUI failures the user hit
    # were never reproducible from the CLI, so the verdict couldn't be trusted. Its data is still
    # reachable through the generic paths: `multiapp app-export "ChatGPT Classic"` and
    # `multiapp session-backup "ChatGPT Classic"` both work.
    notion)          printf 'V full-samemac\nA keychain\nD %s\n%s\n' "$AS_DIR/Notion" "$elec_excludes" ;;
    notion-calendar) printf 'V full-samemac\nA keychain\nD %s\n%s\n' "$AS_DIR/Notion Calendar" "$elec_excludes" ;;
    vscode)          printf 'V full-samemac\nA file\nD %s\n%s\n' "$AS_DIR/Code" "$elec_excludes" ;;
    github)          printf 'V full-samemac\nA keychain\nD %s\n%s\n' "$AS_DIR/GitHub Desktop" "$elec_excludes" ;;
    antigravity)     printf 'V full-samemac\nA file\nD %s\n%s\n' "$AS_DIR/Antigravity" "$elec_excludes" ;;
    antigravity-ide) printf 'V full-samemac\nA file\nD %s\n%s\n' "$AS_DIR/Antigravity IDE" "$elec_excludes" ;;
    openmtp)         printf 'V full-samemac\nA file\nD %s\n' "$AS_DIR/OpenMTP" ;;
    google-chrome)   printf 'V full-samemac\nA keychain\nD %s\n%s\n' "$AS_DIR/Google/Chrome" "$elec_excludes" ;;
    gemini)          printf 'V full-samemac\nA keychain\nD %s\nD %s\nD %s\n' \
                       "$AS_DIR/com.google.GeminiMacOS" "$HOME/Library/HTTPStorages/com.google.GeminiMacOS" \
                       "$HOME/Library/Group Containers/group.com.google.gemini" ;;
    telegram-desktop) # tdesktop keeps everything (incl. the login) in tdata; user_data*/emoji are cache
                     printf 'V full-samemac\nA file\nD %s\nX user_data*\nX emoji\n' "$AS_DIR/Telegram Desktop" ;;
    telegram)        # verified 2026-07-25: 1.6G backup + restore round-trip OK. back up the container's Data (the app's real home) — the container root holds a
                     # system-protected .com.apple.containermanagerd.metadata.plist that tar can't read
                     printf 'V full-samemac\nA keychain\nD %s\nD %s\nX postbox/media\n' \
                       "$HOME/Library/Containers/ru.keepcoder.Telegram/Data" \
                       "$HOME/Library/Group Containers/6N38VWS5BX.ru.keepcoder.Telegram" ;;
    *) return 1 ;;
  esac
}

# full spec = app-specific paths + standard per-bundle-ID session/settings paths, de-duplicated
# (an app spec may already list e.g. HTTPStorages; tarring the same root twice would duplicate it)
full_backup_spec() {
  backup_spec "$1" || return 1
  local seen; seen="$(backup_spec "$1" 2>/dev/null | awk '$1=="D"{sub(/^D /,"");print}')"
  standard_paths "$1" | while IFS= read -r line; do
    local p="${line#D }"
    printf '%s\n' "$seen" | grep -qxF "$p" || printf '%s\n' "$line"
  done
}

app_is_running() { # $1 = registry key → 0 if running
  # Match the running process by its BUNDLE PATH, not by name. AppleScript's
  # `application "X" is running` needs Automation permission (which a GUI caller may not have) and
  # is ambiguous when two apps share an executable name — e.g. ChatGPT vs ChatGPT Classic.
  local path; path="$(reg_field "$1" 2)"; [ -n "$path" ] || return 1
  ps -eo args 2>/dev/null | grep -F "$path/Contents/MacOS/" | grep -qv grep
}

cmd_migratelist() {
  local raw=0; [ "${1:-}" = "--raw" ] && raw=1
  [ "$raw" = 1 ] || printf '%-18s %-14s %-11s %s\n' "APP" "VERDICT" "AUTH" "SAME-MAC BACKUP"
  full_registry | while IFS='|' read -r key path name adapter verdict note; do
    [ -n "$key" ] || continue
    local spec; spec="$(backup_spec "$key" 2>/dev/null)" || { continue; }
    local v a first
    v="$(printf '%s\n' "$spec" | awk '$1=="V"{print $2;exit}')"
    a="$(printf '%s\n' "$spec" | awk '$1=="A"{print $2;exit}')"
    first="$(printf '%s\n' "$spec" | awk '$1=="D"{sub(/^D /,"");print;exit}')"
    [ -e "$first" ] || continue          # only apps with data present on this machine
    if [ "$raw" = 1 ]; then printf '%s|%s|%s\n' "$key" "$v" "$a"       # key|verdict|authlocus (for the GUI)
    else printf '%-18s %-14s %-11s %s\n' "$key" "$v" "$a" "backup available"; fi
  done
  [ "$raw" = 1 ] || { info ""; info "same-machine restore is FULL (login included). moving to another Mac = content + re-login."; }
}

cmd_backup() {
  local key="${1:-}" out="" inc=0
  shift || true
  while [ $# -gt 0 ]; do case "$1" in --include-cache) inc=1;; *) out="$1";; esac; shift; done
  [ -n "$key" ] || die "usage: multiapp backup <app> [out.tar.gz] [--include-cache]"
  local spec; spec="$(full_backup_spec "$key" 2>/dev/null)" || die "no backup profile for '$key' — see: multiapp migrate-list"
  app_is_running "$key" && die "'$key' is running — quit it first (a live app makes an inconsistent backup)"

  # collect existing data roots
  local roots=(); while IFS= read -r line; do
    case "$line" in "D "*) local p="${line#D }"; [ -e "$p" ] && roots+=("$p");; esac
  done <<< "$spec"
  [ "${#roots[@]}" -gt 0 ] || die "no data found on this machine for '$key'"

  local verdict; verdict="$(printf '%s\n' "$spec" | awk '$1=="V"{print $2;exit}')"
  local locus;   locus="$(printf '%s\n' "$spec" | awk '$1=="A"{print $2;exit}')"
  local ver;     ver="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$(reg_field "$key" 2)/Contents/Info.plist" 2>/dev/null || echo unknown)"
  local desk="$HOME/Desktop"; [ -d "$desk" ] || desk="$HOME"
  [ -n "$out" ] || out="$desk/multiapp-backup-${key}-$(date +%Y%m%d-%H%M%S).tar.gz"

  # tar excludes (relative patterns) unless --include-cache
  # always skip macOS' system-protected sandbox metadata (tar can't read it → would abort the backup)
  local exargs=(--exclude=".com.apple.containermanagerd.metadata.plist")
  if [ "$inc" = 0 ]; then
    while IFS= read -r line; do case "$line" in "X "*) exargs+=(--exclude="${line#X }");; esac; done <<< "$spec"
  fi

  [ "$verdict" = experimental ] && warn "'$key' backup is EXPERIMENTAL — same-Mac restore should be full, but cross-machine behavior is unverified"
  warn "this archive will contain your private app data (and, on this Mac, your logged-in session) — keep it safe"
  [ "$inc" = 0 ] && [ "${#exargs[@]}" -gt 0 ] && info "excluding caches (use --include-cache to keep them)"

  # manifest describing what/where, so restore knows the exact target paths
  local stage; stage="$(mktemp -d)"
  {
    printf '{\n  "multiapp_backup": "1",\n  "app": "%s",\n  "appVersion": "%s",\n  "authLocus": "%s",\n  "verdict": "%s",\n' "$key" "$ver" "$locus" "$verdict"
    printf '  "sourceHost": "%s",\n  "macOS": "%s",\n  "includedCache": %s,\n  "dataRoots": [\n' \
      "$(scutil --get ComputerName 2>/dev/null || hostname)" "$(sw_vers -productVersion 2>/dev/null)" "$([ "$inc" = 1 ] && echo true || echo false)"
    local i=0; for r in "${roots[@]}"; do [ $i -gt 0 ] && printf ',\n'; printf '    "%s"' "$r"; i=1; done
    # paths RELATIVE to $HOME: unique per member (two roots can share a basename, e.g.
    # Application Support/com.openai.chat and HTTPStorages/com.openai.chat) and portable across users
    printf '\n  ],\n  "dataRootsRel": [\n'
    i=0; for r in "${roots[@]}"; do [ $i -gt 0 ] && printf ',\n'; printf '    "%s"' "${r#$HOME/}"; i=1; done
    printf '\n  ]\n}\n'
  } > "$stage/manifest.json"

  info "backing up ${#roots[@]} data location(s) for '$key'…"
  # archive: manifest at top, plus every root stored under its path relative to $HOME
  local tarlist=(-C "$stage" manifest.json)
  for r in "${roots[@]}"; do
    tarlist+=(-C "$HOME" "${r#$HOME/}")
  done
  # ${arr[@]+…} guards empty arrays under macOS bash 3.2 + set -u; capture tar's error for diagnosis
  local terr; terr="$(mktemp)"
  if tar -czf "$out" ${exargs[@]+"${exargs[@]}"} "${tarlist[@]}" 2>"$terr"; then
    rm -rf "$stage" "$terr"
    info "backup written → $out  ($(du -sh "$out" 2>/dev/null | awk '{print $1}'))"
    info "restore with:  multiapp restore $key \"$out\""
  else
    local why; why="$(grep -v 'Error exit delayed' "$terr" | head -2 | tr '\n' ' ')"
    rm -rf "$stage" "$terr"; rm -f "$out"; die "backup failed: ${why:-tar error}"
  fi
}

cmd_restore() {
  local key="${1:-}" file="${2:-}" force=0
  [ "${3:-}" = "--force" ] && force=1
  [ -n "$key" ] && [ -n "$file" ] || die "usage: multiapp restore <app> <archive.tar.gz> [--force]"
  [ -f "$file" ] || die "no such file: $file"
  backup_spec "$key" >/dev/null 2>&1 || die "no backup profile for '$key'"
  # safety: reject absolute / traversal members
  tar -tzf "$file" 2>/dev/null | grep -qE '(^/|(^|/)\.\.(/|$))' && die "unsafe archive (absolute or ../ paths) — refusing"
  tar -tzf "$file" 2>/dev/null | grep -q '^manifest.json$' || die "not a Multiapp backup (no manifest)"
  app_is_running "$key" && die "'$key' is running — quit it first before restoring"

  local tmp; tmp="$(mktemp -d)"
  tar -xzf "$file" -C "$tmp" 2>/dev/null || { rm -rf "$tmp"; die "cannot extract archive"; }
  local man="$tmp/manifest.json"
  local aver; aver="$(/usr/bin/python3 -c "import json;print(json.load(open('$man')).get('appVersion','?'))" 2>/dev/null)"
  local iver; iver="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$(reg_field "$key" 2)/Contents/Info.plist" 2>/dev/null || echo unknown)"
  [ "$aver" != "$iver" ] && warn "archive is from $key $aver; installed is $iver — restore anyway if you accept possible format drift"

  # members are stored relative to $HOME → map straight back under THIS user's home
  local -a rels
  while IFS= read -r r; do [ -n "$r" ] && rels+=("$r"); done < <(/usr/bin/python3 -c "
import json;d=json.load(open('$man'))
[print(p) for p in d.get('dataRootsRel') or [p.split('/Library/',1)[-1] and 'Library/'+p.split('/Library/',1)[1] for p in d.get('dataRoots',[])]]" 2>/dev/null)
  [ "${#rels[@]}" -gt 0 ] || { rm -rf "$tmp"; die "manifest has no data paths"; }

  info "will restore into:"; for r in "${rels[@]}"; do info "  ~/$r"; done
  if [ "$force" != 1 ]; then
    printf "Type RESTORE to overwrite the above (current data is moved to Multiapp Trash first): "
    local a; read -r a; [ "$a" = "RESTORE" ] || { rm -rf "$tmp"; die "aborted"; }
  fi

  # Did this archive exclude caches? If so we must MERGE, never replace: the archive is an incomplete
  # copy of the directory, so moving it over the live data would DELETE everything that was excluded.
  # (Found the hard way: a Telegram restore cut its group container from 18,918 files to 521.)
  local incache; incache="$(/usr/bin/python3 -c "import json;print(json.load(open('$man')).get('includedCache',True))" 2>/dev/null)"
  local merge=0; [ "$incache" = "False" ] || [ "$incache" = "false" ] && merge=1

  local bk="$TRASH/restore-backup-$key-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$bk"
  [ "$merge" = 1 ] && info "archive was made without caches → merging into existing data (nothing is deleted)"
  local restored=0
  for rel in "${rels[@]}"; do
    local dest="$HOME/$rel"
    local payload="$tmp/$rel"
    [ -e "$payload" ] || { warn "archive has no payload for ~/$rel — skipped"; continue; }
    local slug; slug="$(printf '%s' "$rel" | tr '/' '_')"   # flat, collision-free staging name
    mkdir -p "$(dirname "$dest")"
    if [ "$merge" = 1 ] && [ -d "$payload" ] && [ -d "$dest" ]; then
      # overlay: overwrite files present in the archive, keep everything else (e.g. media caches).
      # ditto is the macOS-native merge — preserves ACLs/xattrs/resource forks that matter for
      # sandboxed containers and SQLite stores; cp -R is the fallback.
      if ditto "$payload" "$dest" 2>/dev/null || cp -R "$payload"/. "$dest"/ 2>/dev/null; then
        restored=$((restored+1))
      else warn "merge into ~/$rel failed"; fi
    else
      [ -e "$dest" ] && mv "$dest" "$bk/$slug"              # stage current → Trash, then replace
      if mv "$payload" "$dest"; then restored=$((restored+1))
      else
        warn "restore of ~/$rel failed — rolling back"; [ -e "$bk/$slug" ] && mv "$bk/$slug" "$dest"
      fi
    fi
  done
  rm -rf "$tmp"
  rmdir "$bk" 2>/dev/null || true    # nothing staged (pure merge) → don't leave an empty folder
  info "restored $restored data location(s) for '$key'"
  info "previous data staged at: ${bk/#$HOME/~}  (delete when you're happy, or move back to undo)"
  info "relaunch $key — your history is back; the login works too if this Mac's Keychain is unchanged"
}

# ================================================================ login sessions (any app)
# Purpose: save just the LOGIN so you don't have to sign in again (incl. "Sign in with Google").
# Works for ANY installed app — resolved by bundle id, no profile support required.
# Honest scope: restores the login on THIS Mac. It cannot teleport a login to another Mac, because
# the decryption key / token lives in the Keychain (machine+user bound) and is never in the archive.

resolve_app_path() { # $1 = registry key | app name | /path/to/App.app → echoes bundle path
  local a="$1" p c
  p="$(reg_field "$a" 2 2>/dev/null)"
  [ -n "$p" ] && [ -d "$p" ] && { printf '%s' "$p"; return 0; }
  case "$a" in *.app) [ -d "$a" ] && { printf '%s' "$a"; return 0; };; esac
  for c in "/Applications/$a.app" "$HOME/Applications/$a.app" "/System/Applications/$a.app" "/Applications/Utilities/$a.app"; do
    [ -d "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

plist_get() { /usr/libexec/PlistBuddy -c "Print :$2" "$1/Contents/Info.plist" 2>/dev/null; }

session_paths() { # $1 = .app path → absolute paths of login-bearing data that exists
  # NOTE: every existence test here uses `if`, never `[ -e x ] && printf`. Under `set -e` a failing
  # test as the LAST statement of a loop body makes the loop (and this function) return non-zero, which
  # aborted the whole function mid-way — it silently returned only the first match, so Chrome/Firefox/
  # tdesktop detection and every verdict built on it were wrong.
  local app="$1" bid p d n
  bid="$(plist_get "$app" CFBundleIdentifier)"; [ -n "$bid" ] || return 0
  # native / WKWebView apps: cookies + web storage keyed by bundle id
  for p in "$HOME/Library/HTTPStorages/$bid" \
           "$HOME/Library/HTTPStorages/$bid.binarycookies" \
           "$HOME/Library/WebKit/$bid" \
           "$HOME/Library/Cookies/$bid.binarycookies"; do
    if [ -e "$p" ]; then printf '%s\n' "$p"; fi
  done
  # sandboxed apps keep the same things inside their container
  for p in "$HOME/Library/Containers/$bid/Data/Library/Cookies" \
           "$HOME/Library/Containers/$bid/Data/Library/HTTPStorages" \
           "$HOME/Library/Containers/$bid/Data/Library/WebKit"; do
    if [ -e "$p" ]; then printf '%s\n' "$p"; fi
  done
  # Electron/Chromium apps: the auth-bearing subset of the user-data dir (NOT caches/history)
  for n in "$(plist_get "$app" CFBundleName)" "$(basename "$app" .app)" "$bid"; do
    [ -n "$n" ] || continue
    d="$AS_DIR/$n"
    # some vendors nest the data dir (Chrome lives in "Google/Chrome") — look one level down too
    [ -d "$d" ] || d="$(find "$AS_DIR" -maxdepth 2 -type d -name "$n" 2>/dev/null | head -1 || true)"
    [ -n "$d" ] && [ -d "$d" ] && { [ -e "$d/Local State" ] || [ -e "$d/Cookies" ] || [ -e "$d/Network" ] || [ -d "$d/Default" ]; } || continue
    for p in "Cookies" "Cookies-journal" "Local State" "Local Storage" "Session Storage" "IndexedDB" "Network" \
             "Default/Cookies" "Default/Local Storage" "Default/Session Storage" "Default/Network"; do
      if [ -e "$d/$p" ]; then printf '%s\n' "$d/$p"; fi
    done
    break
  done
  # Telegram Desktop (tdesktop) family: the login lives in tdata — its own encrypted key store, NOT
  # the macOS Keychain — so this session really is file-based (and potentially portable).
  # user_data*/emoji are message+emoji caches (~460 MB of 486 MB) and are skipped via session_excludes.
  for n in "$(basename "$app" .app)" "$(plist_get "$app" CFBundleName)"; do
    if [ -n "$n" ] && [ -d "$AS_DIR/$n/tdata" ]; then printf '%s\n' "$AS_DIR/$n/tdata"; break; fi
  done
  # Gecko (Firefox-family): per-profile cookie + session store.
  # Deliberately NOT key4.db / logins.json — those are the saved-PASSWORD vault, not a login session,
  # and copying them around would be a far bigger exposure than this feature needs.
  local prof
  for n in "$(plist_get "$app" CFBundleName)" "$(basename "$app" .app)"; do
    [ -n "$n" ] && [ -d "$AS_DIR/$n/Profiles" ] || continue
    for prof in "$AS_DIR/$n/Profiles"/*; do
      [ -d "$prof" ] || continue
      for p in "cookies.sqlite" "cookies.sqlite-wal" "sessionstore.jsonlz4" "sessionstore-backups"; do
        if [ -e "$prof/$p" ]; then printf '%s\n' "$prof/$p"; fi
      done
    done
    break
  done
  return 0
}

session_excludes() { # $1 = .app path → cache patterns to skip inside session paths
  local app="$1" n
  for n in "$(basename "$app" .app)" "$(plist_get "$app" CFBundleName)"; do
    # tdesktop: tdata holds the login, but user_data*/emoji are ~460 MB of message/emoji cache
    [ -n "$n" ] && [ -d "$AS_DIR/$n/tdata" ] && { printf 'user_data*\nemoji\n'; return; }
  done
  return 0
}

session_portability() { # $1 = .app path → keychain-only | same-mac-only | maybe-portable | none
  # Order matters. A Chromium cookie store IS the session (the Keychain only holds the key that
  # decrypts it), so saving/restoring the files genuinely restores the login on this Mac.
  # A native app with keychain-access-groups keeps the TOKEN ITSELF in the Keychain — its web-storage
  # files are not the login at all. Proven on Gemini (2026-07-25): deleting every session file left it
  # still signed in, because the Keychain was untouched.
  local app="$1" bid n hit ck
  bid="$(plist_get "$app" CFBundleIdentifier)"
  n="$(plist_get "$app" CFBundleName)"; [ -n "$n" ] || n="$(basename "$app" .app)"
  # find the cookie store from the paths we actually collected (handles Chromium profile dirs like
  # Google/Chrome/Default/Cookies and Gecko's Profiles/*/cookies.sqlite, which fixed guesses missed)
  ck=""
  local sp
  while IFS= read -r sp; do
    [ -n "$sp" ] || continue
    case "$sp" in
      */Cookies|*/cookies.sqlite) [ -f "$sp" ] && { ck="$sp"; break; };;
    esac
    if [ -d "$sp" ]; then
      local found; found="$(find "$sp" -maxdepth 3 \( -name Cookies -o -name cookies.sqlite \) -type f 2>/dev/null | head -1 || true)"
      [ -n "$found" ] && { ck="$found"; break; }
    fi
  done < <(session_paths "$app" 2>/dev/null)
  if [ -n "$ck" ] && [ -f "$ck" ]; then
    # scan the WHOLE cookie table, not a sample: an empty store or a first page of unencrypted
    # cookies says nothing (this produced two wrong verdicts before)
    hit="$(/usr/bin/python3 -c "
import sqlite3,shutil,tempfile,os
t=tempfile.mktemp()
try:
    shutil.copy('$ck',t); c=sqlite3.connect(t)
    try:      # Chromium: encrypted_value blob carries a v10/v11 prefix when OS-encrypted
        r=[x[0] for x in c.execute('select encrypted_value from cookies').fetchall() if x[0]]
        v='empty' if not r else ('enc' if any(b[:3] in (b'v10',b'v11') for b in r) else 'plain')
    except sqlite3.OperationalError:   # Gecko: moz_cookies stores values in the clear
        n=c.execute('select count(*) from moz_cookies').fetchone()[0]
        v='plain' if n else 'empty'
    c.close(); print(v)
except Exception: print('unknown')
finally:
    try: os.unlink(t)
    except Exception: pass" 2>/dev/null)"
    [ "$hit" = enc ] && { printf 'same-mac-only'; return; }
    [ "$hit" = plain ] && { printf 'maybe-portable'; return; }
  fi
  # No usable cookie evidence. A "Safe Storage" item alone does NOT mean the login is in these files —
  # Gemini has one yet stayed signed in after every session file was deleted (verified 2026-07-25).
  codesign -d --entitlements :- "$app" 2>/dev/null | grep -q "keychain-access-groups" && { printf 'keychain-only'; return; }
  [ -n "$(session_paths "$app")" ] && printf 'unknown' || printf 'none'
}

cmd_session_backup() {
  local a="${1:-}" out="${2:-}"
  [ -n "$a" ] || die "usage: multiapp session-backup <app> [out.tar.gz]   (app = name, path, or key)"
  local app; app="$(resolve_app_path "$a")" || die "app not found: '$a' (try the exact name, e.g. \"Notion\", or a full /Applications/X.app path)"
  local disp; disp="$(basename "$app" .app)"
  local -a paths=(); while IFS= read -r p; do [ -n "$p" ] && paths+=("$p"); done < <(session_paths "$app")
  [ "${#paths[@]}" -gt 0 ] || die "no login/session data found for '$disp' — its login is probably Keychain-only, which can't be backed up as files"

  local port; port="$(session_portability "$app")"
  local slug; slug="$(printf '%s' "$disp" | tr ' /' '--' | tr -cd 'A-Za-z0-9._-')"
  local desk="$HOME/Desktop"; [ -d "$desk" ] || desk="$HOME"
  [ -n "$out" ] || out="$desk/multiapp-session-${slug}-$(date +%Y%m%d-%H%M%S).tar.gz"

  app_path_is_running "$app" && die "'$disp' is running — quit it first so the session files are consistent"
  warn "this archive contains your LOGIN SESSION — treat it like a password"
  [ "$port" = same-mac-only ] && info "note: this app's session is Keychain-encrypted → restores on THIS Mac only"

  local stage; stage="$(mktemp -d)"
  {
    printf '{\n  "multiapp_session": "1",\n  "app": "%s",\n  "bundleId": "%s",\n  "portability": "%s",\n' \
      "$disp" "$(plist_get "$app" CFBundleIdentifier)" "$port"
    printf '  "sourceHost": "%s",\n  "excludedCache": %s,\n  "paths": [\n' \
      "$(scutil --get ComputerName 2>/dev/null || hostname)" \
      "$([ -n "$(session_excludes "$app" 2>/dev/null)" ] && echo true || echo false)"
    local i=0 p; for p in ${paths[@]+"${paths[@]}"}; do [ $i -gt 0 ] && printf ',\n'; printf '    "%s"' "${p#$HOME/}"; i=1; done
    printf '\n  ]\n}\n'
  } > "$stage/manifest.json"

  local tarlist=(-C "$stage" manifest.json) p
  for p in ${paths[@]+"${paths[@]}"}; do tarlist+=(-C "$HOME" "${p#$HOME/}"); done
  # skip caches that live inside a session path (e.g. tdesktop's tdata/user_data*)
  local exargs=() x
  while IFS= read -r x; do [ -n "$x" ] && exargs+=(--exclude="$x"); done < <(session_excludes "$app" 2>/dev/null)
  [ "${#exargs[@]}" -gt 0 ] && info "skipping in-session caches: $(session_excludes "$app" | tr '\n' ' ')"
  local terr; terr="$(mktemp)"
  if tar -czf "$out" ${exargs[@]+"${exargs[@]}"} "${tarlist[@]}" 2>"$terr"; then
    rm -rf "$stage" "$terr"
    info "session saved (${#paths[@]} item(s)) → $out  ($(du -sh "$out" 2>/dev/null | awk '{print $1}'))"
    info "restore with:  multiapp session-restore \"$a\" \"$out\""
  else
    local why; why="$(grep -v 'Error exit delayed' "$terr" | head -2 | tr '\n' ' ')"
    rm -rf "$stage" "$terr"; rm -f "$out"; die "session backup failed: ${why:-tar error}"
  fi
}

cmd_session_restore() {
  local a="${1:-}" file="${2:-}" force=0
  [ "${3:-}" = "--force" ] && force=1
  [ -n "$a" ] && [ -n "$file" ] || die "usage: multiapp session-restore <app> <archive.tar.gz>"
  [ -f "$file" ] || die "no such file: $file"
  local app; app="$(resolve_app_path "$a")" || die "app not found: '$a'"
  local disp; disp="$(basename "$app" .app)"
  tar -tzf "$file" 2>/dev/null | grep -qE '(^/|(^|/)\.\.(/|$))' && die "unsafe archive (absolute or ../ paths) — refusing"
  tar -tzf "$file" 2>/dev/null | grep -q '^manifest.json$' || die "not a Multiapp session archive"
  app_path_is_running "$app" && die "'$disp' is running — quit it first"

  local tmp; tmp="$(mktemp -d)"
  tar -xzf "$file" -C "$tmp" 2>/dev/null || { rm -rf "$tmp"; die "cannot extract archive"; }
  local -a rels=(); while IFS= read -r r; do [ -n "$r" ] && rels+=("$r"); done \
    < <(/usr/bin/python3 -c "import json;[print(p) for p in json.load(open('$tmp/manifest.json'))['paths']]" 2>/dev/null)
  [ "${#rels[@]}" -gt 0 ] || { rm -rf "$tmp"; die "archive lists no session paths"; }

  info "restoring the saved login for '$disp':"; local r; for r in "${rels[@]}"; do info "  ~/$r"; done
  if [ "$force" != 1 ]; then
    printf "Type RESTORE to replace the current session (previous files staged to Multiapp Trash): "
    local ans; read -r ans; [ "$ans" = "RESTORE" ] || { rm -rf "$tmp"; die "aborted"; }
  fi
  # Same rule as the data restore: if the archive skipped in-session caches it is an incomplete copy of
  # those directories, so MERGE instead of replacing (replacing would delete e.g. tdata/user_data*).
  local exc; exc="$(/usr/bin/python3 -c "import json;print(json.load(open('$tmp/manifest.json')).get('excludedCache',False))" 2>/dev/null)"
  local merge=0; { [ "$exc" = True ] || [ "$exc" = true ]; } && merge=1
  [ "$merge" = 1 ] && info "archive skipped in-session caches → merging (nothing is deleted)"
  local bk="$TRASH/session-backup-$disp-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$bk"
  local n=0
  for r in "${rels[@]}"; do
    local dest="$HOME/$r" payload="$tmp/$r" slug
    [ -e "$payload" ] || { warn "archive has no payload for ~/$r — skipped"; continue; }
    slug="$(printf '%s' "$r" | tr '/' '_')"
    mkdir -p "$(dirname "$dest")"
    if [ "$merge" = 1 ] && [ -d "$payload" ] && [ -d "$dest" ]; then
      if ditto "$payload" "$dest" 2>/dev/null || cp -R "$payload"/. "$dest"/ 2>/dev/null; then n=$((n+1))
      else warn "merge into ~/$r failed"; fi
    else
      [ -e "$dest" ] && mv "$dest" "$bk/$slug"
      if mv "$payload" "$dest"; then n=$((n+1)); else
        warn "restore of ~/$r failed — rolling back"; [ -e "$bk/$slug" ] && mv "$bk/$slug" "$dest"
      fi
    fi
  done
  rmdir "$bk" 2>/dev/null || true
  rm -rf "$tmp"
  info "restored $n session item(s) for '$disp'"
  info "previous files staged at: ${bk/#$HOME/~}"
  info "launch $disp — you should already be signed in (same Mac). If not, its login is Keychain-only."
}

app_path_is_running() { ps -eo args 2>/dev/null | grep -F "$1/Contents/MacOS/" | grep -qv grep; }

# ---- export an app's locally-stored data ("work sessions": Codex chats, Antigravity sessions, …)
# Works for ANY installed app, whether or not Multiapp can profile it.
generic_data_paths() { # $1 = .app path → data locations that exist (deduped)
  local app="$1" bid n d p out=""
  bid="$(plist_get "$app" CFBundleIdentifier)"; [ -n "$bid" ] || return 1
  emit() { case "$out" in *"|$1|"*) ;; *) out="$out|$1|"; printf '%s\n' "$1";; esac; }
  for n in "$(plist_get "$app" CFBundleName)" "$(basename "$app" .app)" "$bid"; do
    if [ -n "$n" ] && [ -d "$AS_DIR/$n" ]; then emit "$AS_DIR/$n"; fi
  done
  if [ -d "$HOME/Library/Containers/$bid/Data" ]; then emit "$HOME/Library/Containers/$bid/Data"; fi
  for d in "$HOME/Library/Group Containers"/*; do
    [ -d "$d" ] || continue
    case "$(basename "$d")" in *"$bid"*) emit "$d";; esac
  done
  for p in "$HOME/Library/HTTPStorages/$bid" "$HOME/Library/WebKit/$bid" "$HOME/Library/Preferences/$bid.plist"; do
    if [ -e "$p" ]; then emit "$p"; fi
  done
  # Home dotfolders — where CLI-style apps actually keep their work sessions
  # (~/.codex for ChatGPT/Codex, ~/.claude for Claude, ~/.antigravity, …). Missing these meant an
  # export of Codex captured almost nothing, since its 600 MB of sessions live here, not in ~/Library.
  local cand
  for n in "$(basename "$app" .app)" "$(plist_get "$app" CFBundleName)" "${bid##*.}"; do
    [ -n "$n" ] || continue
    cand="$(printf '%s' "$n" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
    if [ -d "$HOME/.$cand" ]; then emit "$HOME/.$cand"; fi
  done
  return 0
}

cmd_app_export() {
  local a="${1:-}" out="${2:-}" inc=0
  shift $(( $# > 0 ? 1 : 0 )) || true
  while [ $# -gt 0 ]; do case "$1" in --include-cache) inc=1;; *) [ -z "$out" ] && out="$1";; esac; shift; done
  [ -n "$a" ] || die "usage: multiapp app-export <app> [out.tar.gz] [--include-cache]"
  local app; app="$(resolve_app_path "$a")" || die "app not found: '$a'"
  local disp; disp="$(basename "$app" .app)"
  local -a paths=(); while IFS= read -r p; do [ -n "$p" ] && paths+=("$p"); done < <(generic_data_paths "$app" 2>/dev/null)
  [ "${#paths[@]}" -gt 0 ] || die "no local data found for '$disp' (it may keep everything server-side)"
  app_path_is_running "$app" && die "'$disp' is running — quit it first for a consistent export"

  local slug; slug="$(printf '%s' "$disp" | tr ' /' '--' | tr -cd 'A-Za-z0-9._-')"
  local desk="$HOME/Desktop"; [ -d "$desk" ] || desk="$HOME"
  [ -n "$out" ] || out="$desk/multiapp-export-${slug}-$(date +%Y%m%d-%H%M%S).tar.gz"
  case "$out" in */) out="${out%/}/multiapp-export-${slug}-$(date +%Y%m%d-%H%M%S).tar.gz";; esac
  [ -d "$out" ] && out="$out/multiapp-export-${slug}-$(date +%Y%m%d-%H%M%S).tar.gz"

  local exargs=(--exclude=".com.apple.containermanagerd.metadata.plist")
  if [ "$inc" = 0 ]; then
    local x; for x in "Cache" "Caches" "Code Cache" "GPUCache" "DawnGraphiteCache" "DawnWebGPUCache" "Crashpad" "logs" "Logs" "vm_bundles"; do
      exargs+=(--exclude="$x")
    done
    info "excluding caches/logs (use --include-cache to keep them)"
  fi

  warn "this archive contains '$disp' local data, which may include your signed-in session — keep it safe"
  local stage; stage="$(mktemp -d)"
  {
    printf '{\n  "multiapp_export": "1",\n  "app": "%s",\n  "bundleId": "%s",\n  "appVersion": "%s",\n' \
      "$disp" "$(plist_get "$app" CFBundleIdentifier)" "$(plist_get "$app" CFBundleShortVersionString)"
    printf '  "sourceHost": "%s",\n  "includedCache": %s,\n  "paths": [\n' \
      "$(scutil --get ComputerName 2>/dev/null || hostname)" "$([ "$inc" = 1 ] && echo true || echo false)"
    local i=0 p; for p in ${paths[@]+"${paths[@]}"}; do [ $i -gt 0 ] && printf ',\n'; printf '    "%s"' "${p#$HOME/}"; i=1; done
    printf '\n  ]\n}\n'
  } > "$stage/manifest.json"

  local tarlist=(-C "$stage" manifest.json) p
  for p in ${paths[@]+"${paths[@]}"}; do tarlist+=(-C "$HOME" "${p#$HOME/}"); done
  info "exporting ${#paths[@]} location(s) from '$disp'…"
  local terr; terr="$(mktemp)"
  if tar -czf "$out" "${exargs[@]}" "${tarlist[@]}" 2>"$terr"; then
    rm -rf "$stage" "$terr"
    info "exported → $out  ($(du -sh "$out" 2>/dev/null | awk '{print $1}'))"
  else
    local why; why="$(grep -v 'Error exit delayed' "$terr" | head -2 | tr '\n' ' ')"
    rm -rf "$stage" "$terr"; rm -f "$out"; die "export failed: ${why:-tar error}"
  fi
}

cmd_app_import() {
  local file="${1:-}" force=0
  [ "${2:-}" = "--force" ] && force=1
  [ -n "$file" ] || die "usage: multiapp app-import <archive.tar.gz> [--force]"
  [ -f "$file" ] || die "no such file: $file"
  tar -tzf "$file" 2>/dev/null | grep -qE '(^/|(^|/)\.\.(/|$))' && die "unsafe archive (absolute or ../ paths) — refusing"
  tar -tzf "$file" 2>/dev/null | grep -q '^manifest.json$' || die "not a Multiapp archive (no manifest)"

  local tmp; tmp="$(mktemp -d)"
  tar -xzf "$file" -C "$tmp" 2>/dev/null || { rm -rf "$tmp"; die "cannot extract archive"; }
  local man="$tmp/manifest.json"
  local meta; meta="$(/usr/bin/python3 -c "
import json;d=json.load(open('$man'))
print(d.get('app',''));print(d.get('appVersion','?'));print(d.get('sourceHost','?'))
print('yes' if d.get('includedCache') in (True,'true','True') else 'no')
print('\n'.join(d.get('paths') or d.get('dataRootsRel') or []))" 2>/dev/null)"
  local disp ver host incache
  disp="$(printf '%s\n' "$meta" | sed -n 1p)"
  ver="$(printf '%s\n' "$meta" | sed -n 2p)"
  host="$(printf '%s\n' "$meta" | sed -n 3p)"
  incache="$(printf '%s\n' "$meta" | sed -n 4p)"
  local -a rels=(); while IFS= read -r r; do [ -n "$r" ] && rels+=("$r"); done < <(printf '%s\n' "$meta" | tail -n +5)
  [ -n "$disp" ] && [ "${#rels[@]}" -gt 0 ] || { rm -rf "$tmp"; die "archive manifest is missing app/paths"; }

  info "archive: '$disp' $ver (from $host) — ${#rels[@]} location(s)"
  local app; app="$(resolve_app_path "$disp" 2>/dev/null || true)"
  if [ -n "$app" ]; then
    app_path_is_running "$app" && { rm -rf "$tmp"; die "'$disp' is running — quit it first"; }
    local iver; iver="$(plist_get "$app" CFBundleShortVersionString)"
    [ -n "$iver" ] && [ "$iver" != "$ver" ] && warn "installed $disp is $iver, archive is from $ver — formats may differ"
  else
    warn "'$disp' isn't installed here — data will be restored anyway, ready for when you install it"
  fi

  local r; info "will import into:"; for r in "${rels[@]}"; do info "  ~/$r"; done
  if [ "$force" != 1 ]; then
    printf "Type IMPORT to write this data (anything replaced is staged to Multiapp Trash): "
    local ans; read -r ans; [ "$ans" = "IMPORT" ] || { rm -rf "$tmp"; die "aborted"; }
  fi

  # Same rule as restore: an archive made WITHOUT caches is an incomplete copy of its directories,
  # so it must be merged in, never moved over the live data (that deletes whatever was excluded).
  local merge=0; [ "$incache" = "no" ] && merge=1
  [ "$merge" = 1 ] && info "archive was made without caches → merging (nothing is deleted)"
  local bk="$TRASH/app-import-$(printf '%s' "$disp" | tr ' /' '--')-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$bk"
  local n=0
  for r in "${rels[@]}"; do
    local dest="$HOME/$r" payload="$tmp/$r" slug
    [ -e "$payload" ] || { warn "archive has no payload for ~/$r — skipped"; continue; }
    slug="$(printf '%s' "$r" | tr '/' '_')"
    mkdir -p "$(dirname "$dest")"
    if [ "$merge" = 1 ] && [ -d "$payload" ] && [ -d "$dest" ]; then
      if ditto "$payload" "$dest" 2>/dev/null || cp -R "$payload"/. "$dest"/ 2>/dev/null; then n=$((n+1))
      else warn "merge into ~/$r failed"; fi
    else
      [ -e "$dest" ] && mv "$dest" "$bk/$slug"
      if mv "$payload" "$dest"; then n=$((n+1))
      else warn "import of ~/$r failed — rolling back"; [ -e "$bk/$slug" ] && mv "$bk/$slug" "$dest"; fi
    fi
  done
  rm -rf "$tmp"; rmdir "$bk" 2>/dev/null || true
  info "imported $n location(s) for '$disp'"
  [ -d "$bk" ] && info "replaced data staged at: ${bk/#$HOME/~}"
  info "launch $disp — your sessions should be there (a login only carries over on the Mac that made the archive)"
}

cmd_list_installed() { # every app on this Mac, for the GUI picker:  name|path
  local d a
  for d in /Applications /Applications/Utilities "$HOME/Applications"; do
    [ -d "$d" ] || continue
    for a in "$d"/*.app; do
      [ -d "$a" ] || continue
      printf '%s|%s\n' "$(basename "$a" .app)" "$a"
    done
  done | sort -u
}

cmd_session_check() {
  local a="${1:-}"; [ -n "$a" ] || die "usage: multiapp session-check <app>"
  local app; app="$(resolve_app_path "$a")" || die "app not found: '$a'"
  local disp; disp="$(basename "$app" .app)"
  local -a paths=(); while IFS= read -r p; do [ -n "$p" ] && paths+=("$p"); done < <(session_paths "$app" 2>/dev/null)
  info "$disp — login/session data found: ${#paths[@]:-0} item(s)"
  local p; for p in ${paths[@]+"${paths[@]}"}; do info "  ~/${p#$HOME/}"; done
  case "$(session_portability "$app")" in
    same-mac-only)  info "login: encrypted cookies found → these files ARE the session."
                    info "       Restoring them signs you back in on THIS Mac (the key stays in its Keychain).";;
    keychain-only)  info "login: likely NOT in these files — the app declares a Keychain token."
                    info "       Backing them up probably won't preserve a login (Gemini behaves this way).";;
    maybe-portable) info "login: unencrypted cookies found → these files are the session and may even"
                    info "       work on another Mac. Unverified — test before relying on it.";;
    unknown)        info "login: can't tell from the files (no readable cookie store)."
                    info "       Only the destroy-and-restore test below settles it.";;
    none)           info "login: no session files at all — the login lives only in the Keychain";;
  esac
  info ""
  info "these verdicts are a heuristic. to KNOW: quit the app, session-backup, delete the files above,"
  info "launch (still signed in? then the files aren't the login), then session-restore and relaunch."
}

# ================================================================ commands
cmd_apps() {
  printf '%-20s %-24s %-11s %s\n' "KEY" "APP" "VERDICT" "NOTE"
  full_registry | while IFS='|' read -r key path name adapter verdict note; do
    [ -n "$key" ] || continue
    app_installed "$path" || { printf '%-20s %-24s %-11s %s\n' "$key" "$name" "not installed" ""; continue; }
    printf '%-20s %-24s %-11s %s\n' "$key" "$name" "$verdict" "$note"
  done
}

# --- app discovery / scan ----------------------------------------------------
scan_darwin() {
  local app base display key runtime pc sb
  local added=0 native=0 sandboxed=0 known=0
  local d
  for d in "${SCAN_DIRS[@]}"; do
    [ -d "$d" ] || continue
    for app in "$d"/*.app; do
      [ -d "$app" ] || continue
      if full_registry | awk -F'|' -v p="$app" '$2==p{f=1} END{exit !f}'; then known=$((known+1)); continue; fi
      runtime=""
      if [ -f "$app/Contents/Frameworks/Electron Framework.framework/Versions/A/Electron Framework" ]; then
        runtime="electron"
      else
        pc="$(/usr/libexec/PlistBuddy -c 'Print :NSPrincipalClass' "$app/Contents/Info.plist" 2>/dev/null || true)"
        [ "$pc" = "BrowserCrApplication" ] && runtime="chromium"
      fi
      [ -z "$runtime" ] && { native=$((native+1)); continue; }
      sb="$(codesign -d --entitlements :- "$app" 2>/dev/null | plutil -extract 'com\.apple\.security\.app-sandbox' raw -o - - 2>/dev/null || true)"
      [ "$sb" = "true" ] && { sandboxed=$((sandboxed+1)); continue; }
      base="$(basename "$app" .app)"; display="$base"
      key="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd 'a-z0-9-')"
      [ -n "$key" ] || continue
      if full_registry | awk -F'|' -v k="$key" '$1==k{f=1} END{exit !f}'; then warn "skipping $base — key '$key' taken"; continue; fi
      printf '%s|%s|%s|electron|untested|found by scan (%s); verify: multiapp probe %s\n' \
        "$key" "$app" "$display" "$runtime" "$key" >> "$USER_REG"
      info "  + $display  ->  key: $key  ($runtime, untested)"; added=$((added+1))
    done
  done
  info ""
  info "scan done: $added added, $known known, $native native (no lever), $sandboxed sandboxed"
  [ "$added" -gt 0 ] && info "verify with:  multiapp probe <key>"
}

scan_linux() {
  # parse .desktop files, keep ones whose Exec resolves to an Electron binary
  local desk exec bin base key display added=0 known=0 nonelectron=0
  local d
  for d in "${SCAN_DIRS[@]}"; do
    [ -d "$d" ] || continue
    for desk in "$d"/*.desktop; do
      [ -f "$desk" ] || continue
      exec="$(awk -F= '/^Exec=/{print $2; exit}' "$desk" 2>/dev/null | awk '{print $1}')"
      [ -n "$exec" ] || continue
      bin="$(command -v "$exec" 2>/dev/null || echo "$exec")"
      [ -x "$bin" ] || continue
      # Electron heuristic: an unpacked resources dir or an "electron" string in the binary
      if ! { [ -d "$(dirname "$bin")/resources" ] || strings -a "$bin" 2>/dev/null | grep -qm1 -i electron; }; then
        nonelectron=$((nonelectron+1)); continue
      fi
      if full_registry | awk -F'|' -v p="$bin" '$2==p{f=1} END{exit !f}'; then known=$((known+1)); continue; fi
      base="$(basename "$desk" .desktop)"; display="$base"
      key="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]' | tr ' ._' '-' | tr -cd 'a-z0-9-')"
      [ -n "$key" ] || continue
      if full_registry | awk -F'|' -v k="$key" '$1==k{f=1} END{exit !f}'; then continue; fi
      printf '%s|%s|%s|electron|untested|found by scan (linux); verify: multiapp probe %s\n' \
        "$key" "$bin" "$display" "$key" >> "$USER_REG"
      info "  + $display  ->  key: $key  (electron?, untested)"; added=$((added+1))
    done
  done
  info ""
  info "scan done: $added added, $known known, $nonelectron non-electron skipped"
  [ "$added" -gt 0 ] && info "verify with:  multiapp probe <key>"
}

cmd_scan() {
  mkdir -p "$ROOT"
  info "scanning for profile-capable apps ($PLATFORM)…"
  if [ "$PLATFORM" = darwin ]; then scan_darwin; else scan_linux; fi
}

cmd_new() {
  local key="${1:-}" name="${2:-}"; [ -n "$key" ] && [ -n "$name" ] || die "usage: multiapp new <app> <profile>"
  validate_name "$name"
  require_app "$key" >/dev/null
  local dir; dir="$(profile_dir "$key" "$name")"
  [ -e "$dir" ] && die "profile already exists: $dir"
  mkdir -p "$dir"
  local note; note="$(reg_field "$key" 6)"; [ -n "$note" ] && warn "$note"
  info "created profile '$name' for $key"
  info "launch it:  multiapp launch $key \"$name\""
}

cmd_launch() {
  local key="${1:-}" name="${2:-}"; [ -n "$key" ] && [ -n "$name" ] || die "usage: multiapp launch <app> <profile> [-- app args]"
  shift 2 || true
  validate_name "$name"
  local app; app="$(require_app "$key")"
  local dir; dir="$(profile_dir "$key" "$name")"
  [ -d "$dir" ] || die "no such profile '$name' for '$key' — create it: multiapp new $key $name"
  is_running "$dir" && warn "profile '$name' already has a running instance"
  local note; note="$(reg_field "$key" 6)"; [ -n "$note" ] && warn "$note"
  local adapter; adapter="$(reg_field "$key" 4)"
  local extra=()
  if [ "$adapter" = "vscode" ]; then
    mkdir -p "$dir/extensions"
    extra=(--extensions-dir "$dir/extensions")   # VS Code family parses this itself
  fi
  mkdir -p "$dir/data"
  # EQUALS form for --user-data-dir; ${extra[@]+…} guards macOS bash 3.2 + set -u
  plat_launch "$app" "$dir/data" ${extra[@]+"${extra[@]}"} "$@"
  date +%s > "$dir/.last-launch" 2>/dev/null || true
  info "launched $key/$name"
}

cmd_list() {
  local raw=0 filter=""
  while [ $# -gt 0 ]; do
    case "$1" in --raw) raw=1 ;; *) filter="$1" ;; esac; shift
  done
  [ -d "$PROFILES" ] || { [ "$raw" = 1 ] || info "no profiles yet — create one: multiapp new <app> <profile>"; return; }
  [ "$raw" = 1 ] || printf '%-16s %-20s %-9s %s\n' "APP" "PROFILE" "STATE" "SIZE"
  local appdir key name dir state size
  for appdir in "$PROFILES"/*/; do
    [ -d "$appdir" ] || continue
    key="$(basename "$appdir")"
    [ -n "$filter" ] && [ "$key" != "$filter" ] && continue
    for dir in "$appdir"*/; do
      [ -d "$dir" ] || continue
      name="$(basename "$dir")"
      if is_running "${dir%/}" || is_running "${dir%/}/data"; then state="running"; else state="stopped"; fi
      if [ "$raw" = 1 ]; then
        printf '%s|%s|%s\n' "$key" "$name" "$state"      # fast, no du — used by the menu-bar app
      else
        size="$(du -sh "$dir" 2>/dev/null | awk '{print $1}')"
        printf '%-16s %-20s %-9s %s\n' "$key" "$name" "$state" "$size"
      fi
    done
  done
}

cmd_stop() {
  local key="${1:-}" name="${2:-}"; [ -n "$key" ] && [ -n "$name" ] || die "usage: multiapp stop <app> <profile>"
  local app; app="$(require_app "$key")"
  local dir; dir="$(profile_dir "$key" "$name")"
  local pid
  pid="$(main_pid "$app" "$dir/data")"; [ -z "$pid" ] && pid="$(main_pid "$app" "$dir")"
  [ -n "$pid" ] || die "no running instance for $key/$name"
  kill -TERM "$pid"
  info "sent quit to $key/$name (pid $pid)"
}

cmd_clone() {
  local key="${1:-}" src="${2:-}" dst="${3:-}"
  [ -n "$key" ] && [ -n "$src" ] && [ -n "$dst" ] || die "usage: multiapp clone <app> <src-profile> <dst-profile>"
  validate_name "$src"; validate_name "$dst"
  require_app "$key" >/dev/null
  local sdir ddir; sdir="$(profile_dir "$key" "$src")"; ddir="$(profile_dir "$key" "$dst")"
  [ -d "$sdir" ] || die "no such profile: $key/$src"
  [ -e "$ddir" ] && die "target already exists: $key/$dst"
  { is_running "$sdir" || is_running "$sdir/data"; } && die "stop '$src' before cloning (live databases would copy inconsistently)"
  warn "cloning copies session cookies — the server will see a duplicated session"
  cp_clone "$sdir" "$ddir"
  rm -f "$ddir/.last-launch"
  info "cloned $key/$src → $key/$dst"
}

cmd_rename() {
  local key="${1:-}" old="${2:-}" new="${3:-}"
  [ -n "$key" ] && [ -n "$old" ] && [ -n "$new" ] || die "usage: multiapp rename <app> <old-name> <new-name>"
  validate_name "$old"; validate_name "$new"
  require_app "$key" >/dev/null
  local odir ndir; odir="$(profile_dir "$key" "$old")"; ndir="$(profile_dir "$key" "$new")"
  [ -d "$odir" ] || die "no such profile: $key/$old"
  [ -e "$ndir" ] && die "target name already exists: $key/$new"
  { is_running "$odir" || is_running "$odir/data"; } && die "profile is running — stop it first: multiapp stop $key $old"
  mv "$odir" "$ndir"
  info "renamed $key/$old → $key/$new"
  # refresh a wrapper if one existed for the old name
  local display; display="$(reg_field "$key" 3)"
  if [ "$PLATFORM" = darwin ]; then
    [ -d "$WRAPPERS/$display – $old.app" ] && { rm -rf "$WRAPPERS/$display – $old.app"; cmd_wrapper "$key" "$new"; }
  else
    [ -f "$WRAPPERS/multiapp-$key-$old.desktop" ] && { rm -f "$WRAPPERS/multiapp-$key-$old.desktop"; cmd_wrapper "$key" "$new"; }
  fi
}

cmd_delete() {
  local key="${1:-}" name="${2:-}"; [ -n "$key" ] && [ -n "$name" ] || die "usage: multiapp delete <app> <profile>"
  validate_name "$name"
  local dir; dir="$(profile_dir "$key" "$name")"
  [ -d "$dir" ] || die "no such profile: $key/$name"
  { is_running "$dir" || is_running "$dir/data"; } && die "profile is running — stop it first: multiapp stop $key $name"
  assert_inside_root "$dir"
  printf "Type the profile name to move '%s/%s' to Multiapp Trash (recoverable): " "$key" "$name"
  read -r answer
  [ "$answer" = "$name" ] || die "aborted (name mismatch)"
  mkdir -p "$TRASH"
  mv "$dir" "$TRASH/${key}__${name}__$(date +%Y%m%d-%H%M%S)"
  info "moved to $TRASH — restore by moving it back, purge with: multiapp trash purge"
}

cmd_trash() {
  case "${1:-list}" in
    list)  ls -la "$TRASH" 2>/dev/null || info "trash is empty" ;;
    purge)
      [ -d "$TRASH" ] || { info "trash is empty"; return; }
      printf "Permanently delete everything in %s ? [y/N] " "$TRASH"
      read -r a; [ "$a" = "y" ] || die "aborted"
      assert_inside_root "$TRASH"
      rm -rf "$TRASH"; info "trash purged" ;;
    *) die "usage: multiapp trash [list|purge]" ;;
  esac
}

wrapper_darwin() { # $1=key $2=name $3=app $4=display $5=profile dir
  local key="$1" name="$2" app="$3" display="$4"
  local wapp="$WRAPPERS/$display – $name.app"
  rm -rf "$wapp"; mkdir -p "$WRAPPERS"
  # AppleScript applet = real Mach-O stub → Launch Services runs it reliably
  # (plain script-executable bundles are silently refused by LS on macOS 26)
  # every argument goes through AppleScript's `quoted form of` → spaced names are safe
  osacompile -o "$wapp" \
    -e "do shell script quoted form of \"$SELF\" & \" launch \" & quoted form of \"$key\" & \" \" & quoted form of \"$name\" & \" &> /dev/null &\"" \
    || die "osacompile failed"
  local bidname; bidname="$(printf '%s' "$name" | tr ' ' '-')"   # bundle ids must not contain spaces
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier com.multiapp.profile.${key}.${bidname}" "$wapp/Contents/Info.plist" 2>/dev/null || \
    /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string com.multiapp.profile.${key}.${bidname}" "$wapp/Contents/Info.plist"
  local iconname icns
  iconname="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIconFile' "$app/Contents/Info.plist" 2>/dev/null || true)"
  [ -n "$iconname" ] && { icns="$app/Contents/Resources/${iconname%.icns}.icns"; [ -f "$icns" ] && cp "$icns" "$wapp/Contents/Resources/applet.icns"; }
  codesign --force -s - "$wapp" 2>/dev/null || true
  info "wrapper created: $wapp"
  info "drag it to the Dock; it launches this profile with one click"
}

wrapper_linux() { # $1=key $2=name $3=app $4=display
  local key="$1" name="$2" display="$4"
  mkdir -p "$WRAPPERS"
  local f="$WRAPPERS/multiapp-$key-$name.desktop"
  cat > "$f" <<DESK
[Desktop Entry]
Type=Application
Name=$display – $name
Comment=Multiapp isolated profile
Exec=$SELF launch $key $name
Terminal=false
Categories=Utility;
DESK
  chmod +x "$f"
  info "launcher created: $f  (appears in your app menu)"
}

cmd_wrapper() {
  local key="${1:-}" name="${2:-}"; [ -n "$key" ] && [ -n "$name" ] || die "usage: multiapp wrapper <app> <profile>"
  validate_name "$name"
  local app; app="$(require_app "$key")"
  local dir; dir="$(profile_dir "$key" "$name")"
  [ -d "$dir" ] || die "no such profile: $key/$name"
  local display; display="$(reg_field "$key" 3)"
  if [ "$PLATFORM" = darwin ]; then wrapper_darwin "$key" "$name" "$app" "$display" "$dir"
  else wrapper_linux "$key" "$name" "$app" "$display"; fi
}

cmd_probe() { # canary: does this app honor --user-data-dir= ?  (seed of E10)
  local key="${1:-}"; [ -n "$key" ] || die "usage: multiapp probe <app>"
  local path; path="$(reg_field "$key" 2)"
  [ -n "$path" ] || die "unknown app '$key'"
  app_installed "$path" || die "not installed: $path"
  local tmp="$ROOT/Probes/$key-$$"
  mkdir -p "$tmp"
  info "probing $key (launches for ~10s)…"
  plat_launch "$path" "$tmp"
  sleep 10
  local verdict newv newnote
  if [ -n "$(ls "$tmp" 2>/dev/null)" ]; then
    verdict="HONORED"; newv="supported"
    newnote="probe $(date +%Y-%m-%d): flag honored (data isolation); account isolation not verified"
  else
    verdict="IGNORED"; newv="unsupported"
    newnote="probe $(date +%Y-%m-%d): flag ignored (app likely overrides its data path)"
  fi
  ps -eo pid,args 2>/dev/null | grep -F -- "--user-data-dir=$tmp" | grep -v grep | awk '{print $1}' | xargs kill -TERM 2>/dev/null || true
  sleep 2
  ps -eo pid,args 2>/dev/null | grep -F -- "--user-data-dir=$tmp" | grep -v grep | awk '{print $1}' | xargs kill -9 2>/dev/null || true
  assert_inside_root "$tmp"; rm -rf "$tmp"
  info "$key: --user-data-dir= $verdict"
  if [ -f "$USER_REG" ] && grep -q "^$key|" "$USER_REG"; then
    awk -F'|' -v OFS='|' -v k="$key" -v v="$newv" -v n="$newnote" '$1==k{$5=v;$6=n} {print}' "$USER_REG" > "$USER_REG.tmp" && mv "$USER_REG.tmp" "$USER_REG"
    info "registry updated: $key → $newv"
  fi
}

# ------------------------------------------------ session-level ops (claude adapter)
# Storage model (verified on macOS 2026-07-15; Linux paths analogous under ~/.config):
#   session INDEX:  <userData>/claude-code-sessions/<acct>/<sub>/local_<id>.json  (per profile)
#   TRANSCRIPTS:    ~/.claude/projects/<encoded-cwd>/<cliSessionId>.jsonl         (shared per machine)
# ⚠ Because transcripts live in the REAL home, --user-data-dir does NOT isolate them. Copying an
#   index file alone would leave two profiles reading/writing ONE transcript — a live session
#   shared across two accounts. `transfer` therefore mints new ids and duplicates the transcript.
claude_data_root() { # $1=profile name or "main" → userData dir
  if [ "$1" = "main" ]; then printf '%s' "$CLAUDE_MAIN"
  else local d; d="$(profile_dir claude "$1")"; [ -d "$d" ] || die "no such claude profile: $1 (name or 'main')"; printf '%s' "$d/data"; fi
}

require_claude() { [ "${1:-}" = "claude" ] || die "session-level commands support 'claude' only (other apps: whole-profile export/import)"; }

list_claude_sessions() { # $1=userData → TSV: file cli date cwd title
  python3 - "$1" <<'PY'
import glob, json, os, sys, datetime
root = os.path.join(sys.argv[1], "claude-code-sessions")
rows = []
for f in glob.glob(os.path.join(root, "*", "*", "local_*.json")):
    try: d = json.load(open(f))
    except Exception: continue
    ts = d.get("lastActivityAt") or d.get("createdAt") or 0
    rows.append((ts, f, d.get("cliSessionId",""), d.get("cwd",""), (d.get("title") or "(no title)")[:70]))
rows.sort(reverse=True)
for ts, f, cli, cwd, title in rows:
    date = datetime.datetime.fromtimestamp(ts/1000).strftime("%Y-%m-%d %H:%M") if ts else "?"
    print(f"{f}\t{cli}\t{date}\t{cwd}\t{title}")
PY
}

encode_cwd() { python3 -c 'import re,sys; print(re.sub(r"[^A-Za-z0-9-]","-",sys.argv[1]))' "$1"; }

pick_sessions() { # $1=userData $2=optional preselection → chosen TSV lines on stdout
  local tmp; tmp="$(mktemp)"
  list_claude_sessions "$1" > "$tmp"
  [ -s "$tmp" ] || { rm -f "$tmp"; die "no Claude Code sessions found in: $1"; }
  local sel="${2:-}"
  if [ -z "$sel" ]; then
    local i=0
    while IFS=$'\t' read -r f cli date cwd title; do i=$((i+1)); printf '%3d) %s  %-40s  %s\n' "$i" "$date" "$title" "$cwd" >&2; done < "$tmp"
    printf 'Select sessions (e.g. 1,3,5 or "all"): ' >&2; read -r sel
  fi
  if [ "$sel" = "all" ]; then cat "$tmp"
  else local n; for n in $(printf '%s' "$sel" | tr ',' ' '); do [[ "$n" =~ ^[0-9]+$ ]] || { rm -f "$tmp"; die "bad selection: $n"; }; sed -n "${n}p" "$tmp"; done; fi
  rm -f "$tmp"
}

dst_account_dir() { # $1=dst userData → newest <acct>/<sub> dir, or empty
  [ -d "$1/claude-code-sessions" ] || return 0
  find "$1/claude-code-sessions" -mindepth 2 -maxdepth 2 -type d 2>/dev/null \
    | while read -r d; do printf '%s %s\n' "$(stat_mtime "$d")" "$d"; done | sort -rn | head -1 | cut -d' ' -f2-
}

cmd_sessions() {
  require_claude "${1:-}"; local name="${2:-main}" raw=0
  [ "${3:-}" = "--raw" ] && raw=1
  local root; root="$(claude_data_root "$name")"
  if [ "$raw" = 1 ]; then list_claude_sessions "$root"; return; fi   # TSV for the GUI
  info "Claude Code sessions in '$name' ($root):"
  local i=0
  list_claude_sessions "$root" | while IFS=$'\t' read -r f cli date cwd title; do i=$((i+1)); printf '%3d) %s  %-40s  %s\n' "$i" "$date" "$title" "$cwd"; done
}

cmd_transfer() {
  require_claude "${1:-}"; local src="${2:-}" dst="${3:-}" presel="${4:-}"
  [ -n "$src" ] && [ -n "$dst" ] || die "usage: multiapp transfer claude <src|main> <dst|main> [1,3,5|all]"
  [ "$src" = "$dst" ] && die "source and destination are the same"
  local sroot droot; sroot="$(claude_data_root "$src")"; droot="$(claude_data_root "$dst")"
  local acct; acct="$(dst_account_dir "$droot")"
  if [ -z "$acct" ]; then
    warn "destination '$dst' has no Claude Code identity yet."
    warn "Open the Claude Code tab once in that profile (start any tiny session), then re-run."
    die  "aborting — cannot pick a destination account directory"
  fi
  warn "sessions contain your private conversation data"
  local chosen; chosen="$(pick_sessions "$sroot" "$presel")"
  local copied=0 notranscript=0
  while IFS=$'\t' read -r f cli date cwd title; do
    [ -n "$f" ] || continue
    # A TRUE COPY. Copying only the index file would leave both profiles pointing at the SAME
    # transcript in the shared ~/.claude — the session would then be live-shared between two
    # accounts (and two writers could corrupt it). So we mint fresh ids and duplicate the
    # transcript, rewriting the embedded session id, giving the destination an independent copy.
    # NB: do NOT name these src/dst — that would clobber the function's source/dest profile args
    local newcli newlocal proj tsrc tdst
    newcli="$(/usr/bin/python3 -c 'import uuid;print(uuid.uuid4())')"
    newlocal="$(/usr/bin/python3 -c 'import uuid;print(uuid.uuid4())')"
    proj="$(encode_cwd "$cwd")"
    tsrc="$HOME/.claude/projects/$proj/$cli.jsonl"
    tdst="$HOME/.claude/projects/$proj/$newcli.jsonl"
    if [ -f "$tsrc" ]; then
      LC_ALL=C sed "s/$cli/$newcli/g" "$tsrc" > "$tdst"
    else
      notranscript=$((notranscript+1))
    fi
    /usr/bin/python3 - "$f" "$acct/local_$newlocal.json" "$newcli" "local_$newlocal" <<'PY'
import json, sys
src, dst, newcli, newsid = sys.argv[1:5]
d = json.load(open(src))
d["cliSessionId"] = newcli
d["sessionId"]    = newsid
json.dump(d, open(dst, "w"))
PY
    copied=$((copied+1))
  done <<< "$chosen"
  info "copied $copied session(s) into '$dst' as independent copies"
  [ "$notranscript" -gt 0 ] && warn "$notranscript had no transcript file (index copied only)"
  info "the originals in '$src' are untouched and stay separate from now on"
  info "restart the '$dst' instance to see them in the session list"
}

cmd_export() {
  local key="${1:-}" name="${2:-}"; [ -n "$key" ] && [ -n "$name" ] || die "usage: multiapp export <app> <profile|main> [out.tar.gz]"
  local desk="$HOME/Desktop"; [ -d "$desk" ] || desk="$HOME"
  local out="${3:-$desk/multiapp-${key}-${name}-$(date +%Y%m%d-%H%M%S).tar.gz}"
  if [ "$key" != "claude" ]; then
    local dir; dir="$(profile_dir "$key" "$name")"
    [ -d "$dir" ] || die "no such profile: $key/$name"
    { is_running "$dir" || is_running "$dir/data"; } && die "stop the profile before exporting"
    warn "the archive will contain session cookies/logins — keep it private"
    tar -czf "$out" -C "$(dirname "$dir")" "$(basename "$dir")"
    info "exported whole profile → $out"; return
  fi
  local presel="${4:-}"   # optional non-interactive selection (e.g. "all") — used by the GUI
  local root; root="$(claude_data_root "$name")"
  warn "the archive will contain your private conversations — keep it private"
  local chosen; chosen="$(pick_sessions "$root" "$presel")"
  local stage; stage="$(mktemp -d)"
  mkdir -p "$stage/index" "$stage/transcripts"
  printf '{"multiapp":"%s","app":"claude","kind":"claude-code-sessions"}\n' "$VERSION" > "$stage/manifest.json"
  local n=0 missing=0
  while IFS=$'\t' read -r f cli date cwd title; do
    [ -n "$f" ] || continue
    cp "$f" "$stage/index/"
    local proj; proj="$(encode_cwd "$cwd")"
    local tr="$HOME/.claude/projects/$proj/$cli.jsonl"
    if [ -f "$tr" ]; then mkdir -p "$stage/transcripts/$proj"; cp "$tr" "$stage/transcripts/$proj/"; n=$((n+1))
    else warn "transcript missing for: $title"; missing=$((missing+1)); fi
  done <<< "$chosen"
  tar -czf "$out" -C "$stage" .
  rm -rf "$stage"
  info "exported $n session(s) ($missing without transcript) → $out"
  info "import on the other machine:  multiapp import claude <profile|main> <this file>"
}

cmd_import() {
  local key="${1:-}" name="${2:-}" file="${3:-}"
  [ -n "$key" ] && [ -n "$name" ] && [ -n "$file" ] || die "usage: multiapp import <app> <profile|main> <archive.tar.gz>"
  [ -f "$file" ] || die "no such file: $file"
  tar -tzf "$file" | grep -qE '(^/|(^|/)\.\.(/|$))' && die "unsafe archive (absolute or ../ paths) — refusing"
  if [ "$key" != "claude" ] || ! tar -tzf "$file" | grep -q '^\./manifest.json$'; then
    validate_name "$name"; require_app "$key" >/dev/null
    local dir; dir="$(profile_dir "$key" "$name")"
    [ -e "$dir" ] && die "profile already exists: $key/$name"
    mkdir -p "$dir"; tar -xzf "$file" -C "$dir" --strip-components 1
    info "imported archive as new profile $key/$name"; return
  fi
  local root; root="$(claude_data_root "$name")"
  local acct; acct="$(dst_account_dir "$root")"
  [ -n "$acct" ] || die "destination '$name' has no Claude Code identity yet — open Claude Code there once, then re-run"
  local stage; stage="$(mktemp -d)"
  tar -xzf "$file" -C "$stage"
  local idx=0 trn=0 f
  for f in "$stage/index"/local_*.json; do
    [ -e "$f" ] || continue
    [ -e "$acct/$(basename "$f")" ] && continue
    cp "$f" "$acct/"; idx=$((idx+1))
  done
  if [ -d "$stage/transcripts" ]; then
    ( cd "$stage/transcripts" && find . -name "*.jsonl" ) | while read -r rel; do
      rel="${rel#./}"; mkdir -p "$HOME/.claude/projects/$(dirname "$rel")"
      [ -e "$HOME/.claude/projects/$rel" ] || cp "$stage/transcripts/$rel" "$HOME/.claude/projects/$rel"
    done
    trn="$(find "$stage/transcripts" -name '*.jsonl' | wc -l | xargs)"
  fi
  rm -rf "$stage"
  info "imported $idx session index file(s), $trn transcript(s)"
  info "restart the '$name' instance to see them. Sessions reference the original machine's folder paths."
}

# ---------------------------------------------------------- install / stub
cmd_install_stub() { # writes a self-locating launcher onto PATH (move-proof)
  local bindir="$HOME/.local/bin"; mkdir -p "$bindir" "$(dirname "$CONF")"
  printf '%s' "$SELF" > "$CONF"
  rm -f "$bindir/multiapp"   # CRITICAL: drop any existing symlink so we don't write through it into the real script
  cat > "$bindir/multiapp" <<'STUB'
#!/usr/bin/env bash
# multiapp launcher stub (move-proof) — resolves the real script dynamically.
# Generated by `multiapp install-stub`. Do not edit; safe to keep across folder moves.
set -euo pipefail
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/multiapp/target"
target=""; [ -f "$CONF" ] && target="$(cat "$CONF" 2>/dev/null || true)"
if [ ! -x "$target" ]; then
  # self-heal after a move: use the OS file index (instant — NOT a recursive find,
  # which can hang for minutes on large cloud-synced folders).
  found=""
  case "$(uname -s)" in
    Darwin) found="$(mdfind "kMDItemFSName == 'multiapp'" 2>/dev/null | grep -m1 '/Multiapp/prototype/multiapp$' || true)" ;;
    *) found="$( { command -v plocate >/dev/null 2>&1 && plocate multiapp || locate multiapp; } 2>/dev/null | grep -m1 '/Multiapp/prototype/multiapp$' || true)" ;;
  esac
  [ -n "$found" ] && [ -x "$found" ] && { target="$found"; mkdir -p "$(dirname "$CONF")"; printf '%s' "$target" > "$CONF"; }
fi
[ -x "$target" ] || { echo "multiapp: real script not found after a move. Run once from its new location:  bash '<new path>/prototype/multiapp' install-stub" >&2; exit 1; }
exec "$target" "$@"
STUB
  chmod +x "$bindir/multiapp"
  info "installed move-proof launcher → $bindir/multiapp"
  info "target recorded → $CONF"
  case ":$PATH:" in *":$bindir:"*) : ;; *) warn "$bindir is not on PATH — add: export PATH=\"$bindir:\$PATH\"";; esac
}

cmd_doctor() {
  info "multiapp $VERSION  ($PLATFORM)"
  info "os:        $(os_version)"
  info "root:      $ROOT"
  info "self:      $SELF"
  info "stub tgt:  $(cat "$CONF" 2>/dev/null || echo '(unset — run: multiapp install-stub)')"
  info "profiles:  $(find "$PROFILES" -mindepth 2 -maxdepth 2 -type d 2>/dev/null | wc -l | xargs)"
  info "trash:     $(ls "$TRASH" 2>/dev/null | wc -l | xargs) item(s)"
  local key path missing=0
  while IFS='|' read -r key path _; do
    [ -n "$key" ] || continue
    app_installed "$path" || { info "  missing app: $key ($path)"; missing=1; }
  done <<< "$REGISTRY"
  [ "$missing" = 0 ] && info "all registry apps installed"
}

cmd_help() {
  cat <<HELP
multiapp $VERSION — run multiple isolated profiles of desktop apps ($PLATFORM)

usage: multiapp <command> [args]

  apps                          list known apps + support verdicts
  scan                          discover newly installed Electron/Chromium apps → registry
  new     <app> <profile>       create a profile
  launch  <app> <profile> [--] [args]   launch an isolated instance
  list    [app]                 list profiles (state, size)
  stop    <app> <profile>       gracefully quit a profile's instance
  clone   <app> <src> <dst>     duplicate a stopped profile
  rename  <app> <old> <new>     rename a stopped profile (wrapper regenerated)
  sessions claude <prof|main>   list Claude Code sessions of a profile ("main" = real app)
  transfer claude <src> <dst> [sel]   copy chosen sessions between profiles on this machine
  export  <app> <prof|main> [f] claude: archive chosen sessions (for another machine); others: whole profile
  import  <app> <prof|main> <f> merge a session archive (claude) / restore whole profile (others)
  app-export      <app> [dir]   export ANY app's local data (sessions/settings) to a folder
  app-import      <archive>     import an app-export archive back (merges; never deletes)
  session-check   <app>         show an app's login/session files + whether they'd survive a Mac move
  session-backup  <app> [out]   save ONLY the login session (any installed app; small + fast)
  session-restore <app> <file>  put a saved login back (same Mac)
  migrate-list                  apps whose real data can be backed up on this machine
  backup  <app> [out] [--include-cache]   back up an app's REAL data (same-Mac restore = full, incl. login)
  restore <app> <archive>       restore a backup (quits nothing; stages current data to Trash first)
  delete  <app> <profile>       move a profile to Multiapp Trash (staged, recoverable)
  trash   [list|purge]          inspect / empty the staged trash
  wrapper <app> <profile>       create a clickable launcher (Dock .app / .desktop)
  probe   <app>                 canary-test whether the app honors the flag
  install-stub                  put a move-proof 'multiapp' launcher on PATH
  doctor                        environment self-check
  help                          this text

mechanism: launch <App> with --user-data-dir=<profile>   (equals form; verified 2026-07-15)
profiles live in: $PROFILES
HELP
}

# ================================================================ dispatch
cmd="${1:-help}"; shift || true
case "$cmd" in
  apps)      cmd_apps "$@" ;;
  scan)      cmd_scan "$@" ;;
  new)       cmd_new "$@" ;;
  launch)    cmd_launch "$@" ;;
  list|ls)   cmd_list "$@" ;;
  stop)      cmd_stop "$@" ;;
  clone)     cmd_clone "$@" ;;
  rename|mv) cmd_rename "$@" ;;
  sessions)  cmd_sessions "$@" ;;
  transfer)  cmd_transfer "$@" ;;
  export)    cmd_export "$@" ;;
  import)    cmd_import "$@" ;;
  backup)    cmd_backup "$@" ;;
  restore)   cmd_restore "$@" ;;
  migrate-list) cmd_migratelist "$@" ;;
  session-backup)  cmd_session_backup "$@" ;;
  session-restore) cmd_session_restore "$@" ;;
  session-check)   cmd_session_check "$@" ;;
  app-export)      cmd_app_export "$@" ;;
  app-import)      cmd_app_import "$@" ;;
  list-installed)  cmd_list_installed "$@" ;;
  delete|rm) cmd_delete "$@" ;;
  trash)     cmd_trash "$@" ;;
  wrapper)   cmd_wrapper "$@" ;;
  probe)     cmd_probe "$@" ;;
  install-stub) cmd_install_stub "$@" ;;
  doctor)    cmd_doctor "$@" ;;
  help|--help|-h|version|--version) cmd_help ;;
  *) die "unknown command '$cmd' — see: multiapp help" ;;
esac
