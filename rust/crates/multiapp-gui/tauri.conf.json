{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multiapp",
  "version": "0.3.5",
  "identifier": "com.multiapp.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Multiapp",
        "width": 900,
        "height": 660,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Run multiple isolated profiles of the same app",
    "longDescription": "Run several independent profiles of the same desktop app - separate logins, cookies and settings - without modifying, copying or re-signing the app.",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxRTNGRjA3RjMzNDJEMjIKUldRaUxUVHpCLy9qUVNVaUdpNVpTeXlDYlZlZXJMK0ZPRzc3R2VoNE5XZ1pOSDFNMExxN1NCK20K",
      "endpoints": [
        "https://github.com/smoker070/multiapp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
