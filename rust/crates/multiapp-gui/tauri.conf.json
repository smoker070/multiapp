{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multiapp",
  "version": "0.3.0",
  "identifier": "com.multiapp.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Multiapp",
        "width": 460,
        "height": 640,
        "minWidth": 400,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Run multiple isolated profiles of the same app",
    "longDescription": "Run several independent profiles of the same desktop app - separate logins, cookies and settings - without modifying, copying or re-signing the app."
  }
}
