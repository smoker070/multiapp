# build artifacts
app/build/
app/dist/

# macOS
.DS_Store
.AppleDouble
.LSOverride
# NOTE: the usual `Icon?` line is deliberately NOT used. It matches any five-character name
# beginning with "Icon" — including a directory called `icons`, which silently excluded every
# application icon and would have failed the Windows build on a missing icon.ico.

# editors
.vscode/
.idea/
*.swp

# Backup / export archives — these can contain a LIVE LOGIN SESSION.
# The tool itself warns "treat it like a password"; never let one get committed.
*.tar.gz
*.tgz
*.zip
*.dmg
multiapp-backup-*
multiapp-export-*
multiapp-session-*
registry.local
migrate-cache

# Claude Code / agent tool state (contains local absolute paths)
.claude/

# Rust build output (gigabytes — never commit)
rust/target/
**/*.rs.bk

# GUI preview scratch (lives outside the repo, but never commit a copy)
uipreview/

# Tauri build output — regenerated on every build
rust/crates/multiapp-gui/gen/
